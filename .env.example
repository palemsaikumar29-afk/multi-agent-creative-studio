# Copy to .env and fill in what you have. Never commit a filled .env.
LLM_PROVIDER=groq
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b
LLM_MAX_ATTEMPTS=3
LLM_BACKOFF_BASE=1.0
# Image provider: auto (pollinations -> dalle -> placeholder), pollinations, dalle, placeholder
IMAGE_PROVIDER=auto
OPENAI_IMAGE_MODEL=dall-e-3
POLLINATIONS_MODEL=flux
STUDIO_OUTPUT_DIR=outputs
